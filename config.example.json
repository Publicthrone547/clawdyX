{
  "telegram": {
    "owner_user_id": 0,
    "poll_timeout_seconds": 30
  },
  "claude": {
    "binary": "/opt/homebrew/bin/claude",
    "default_model": "fable",
    "default_effort": "auto",
    "setting_sources": "user",
    "strict_mcp_config": true,
    "job_timeout": "15m",
    "max_turns": 60,
    "max_budget_usd": 0,
    "max_concurrent_jobs": 2,
    "max_queue_per_session": 5,
    "max_output_bytes": 1048576,
    "max_child_rss_mb": 2048,
    "bg_wait_ceiling_ms": 60000,
    "child_path": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "extra_disallowed_tools": []
  },
  "workspaces": [
    {
      "name": "my-project",
      "path": "/Users/you/projects/my-project",
      "default_mode": "observe",
      "allowed_commands": [
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(make test *)",
        "Bash(go test *)",
        "Bash(go build *)",
        "Bash(go vet *)"
      ],
      "denied_commands": [
        "Bash(rm *)",
        "Bash(rmdir *)",
        "Bash(sudo *)",
        "Bash(git push *)",
        "Bash(git remote *)",
        "Bash(curl *)",
        "Bash(wget *)",
        "Bash(claude *)",
        "Bash(dd *)",
        "Bash(chmod -R *)",
        "Bash(chown *)",
        "Bash(ssh *)",
        "Bash(scp *)",
        "Bash(nc *)",
        "Bash(ncat *)",
        "Bash(crontab *)",
        "Bash(shutdown *)",
        "Bash(reboot *)",
        "Bash(brew *)",
        "Bash(launchctl *)",
        "Bash(defaults write *)",
        "Bash(security *)",
        "Bash(csrutil *)",
        "Bash(diskutil *)",
        "Bash(tmutil *)"
      ]
    }
  ],
  "default_workspace": "my-project",
  "shutdown_command_enabled": false,
  "modes": {
    "automation_enabled": false
  },
  "desktop": {
    "open_urls": true,
    "browser_app": "Firefox",
    "screen_control": false,
    "camera": false
  },
  "state_dir": "",
  "log_dir": "",
  "logging": {
    "level": "info"
  },
  "retention": {
    "audit_days": 180,
    "job_events_days": 14,
    "jobs_days": 90,
    "processed_updates_days": 7
  }
}
